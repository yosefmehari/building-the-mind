# ==============================================================================
# Building the Mind with Joss - Environment Variables Template
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local to GitHub!
# ==============================================================================

# Database (PostgreSQL) - Required in Step 3
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/building_the_mind"

# Authentication Secret (Used for encrypting session cookies & tokens)
# Generate a random 32+ character string (e.g. `openssl rand -base64 32`)
AUTH_SECRET="your-super-secret-auth-key-change-in-production"

# Initial administrator provisioning (used only by `npm run admin:create`)
ADMIN_EMAIL="yosefmehari2404@gmail.com"
ADMIN_PASSWORD="set-this-locally-and-never-commit-it"

# Next.js App URL (Change to production domain when deployed)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage Configuration (S3 / Cloudinary / Supabase / Local) - Required in Step 12 & 13
STORAGE_URL=""
STORAGE_KEY=""
STORAGE_SECRET=""
